{
  "name": "did-jwt",
  "version": "8.0.18",
  "description": "Library for Signing and Verifying JWTs that use DIDs as issuers and JWEs that use DIDs as recipients",
  "type": "module",
  "source": "src/index.ts",
  "main": "./lib.commonjs/index.js",
  "module": "./lib.esm/index.js",
  "types": "./lib.commonjs/index.d.ts",
  "files": [
    "lib.esm",
    "lib.commonjs",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib.esm/index.d.ts",
        "default": "./lib.esm/index.js"
      },
      "require": {
        "types": "./lib.commonjs/index.d.ts",
        "default": "./lib.commonjs/index.js"
      }
    }
  },
  "browser": "./dist/did-jwt.js",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "canary": "node canary/unpack.mjs && tsx canary/canary.esm.ts && node canary/canary.cjs.cjs && (cd canary/consumer && tsc --noEmit)",
    "canary:unpack": "node canary/unpack.mjs",
    "canary:esm": "tsx canary/canary.esm.ts",
    "canary:cjs": "node canary/canary.cjs.cjs",
    "canary:types": "cd canary/consumer && tsc --noEmit",
    "build": "pnpm run build:common && pnpm run build:esm",
    "build:common": "tsc --project tsconfig.common.json && echo '{\"type\":\"commonjs\"}' > lib.commonjs/package.json",
    "build:esm": "tsc --project tsconfig.esm.json && echo '{\"type\":\"module\"}' > lib.esm/package.json",
    "clean": "rimraf lib dist",
    "build:docs": "echo 'PLEASE UPDATE REFERENCE DOCS MANUALLY'",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.[jt]s\"",
    "prepublishOnly": "pnpm run test:ci && pnpm run format && pnpm run lint",
    "release": "semantic-release --debug"
  },
  "author": "Pelle Braendgaard",
  "contributors": [
    "Mircea Nistor <mircea.nistor@mesh.xyz>",
    "Oliver Terbu",
    "Joel Thorstensson <oed@3box.io>",
    "Jack Tanner <jack+public@tonomy.foundation>",
    "Rebal Alhaqash <rebal@tonomy.foundation>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentralized-identity/did-jwt.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/eslintrc": "^3.3.7",
    "@ethersproject/address": "5.8.0",
    "@greymass/eosio": "^0.7.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tonomy/antelope-did": "^0.1.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/jwk-to-pem": "2.0.3",
    "@types/node": "^20.1.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "codecov": "3.8.3",
    "cross-env": "7.0.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jsontokens": "4.0.1",
    "jsonwebtoken": "9.0.2",
    "jwk-to-pem": "2.0.7",
    "microbundle": "0.15.1",
    "mockdate": "3.0.5",
    "prettier": "3.7.3",
    "regenerator-runtime": "0.14.1",
    "rimraf": "^5.0.0",
    "semantic-release": "22.0.12",
    "ts-node": "10.9.2",
    "tsx": "^4.23.13",
    "tweetnacl": "1.0.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "webpack": "5.103.0",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.0.0",
    "@noble/hashes": "^1.3.0",
    "@scure/base": "^2.0.0",
    "canonicalize": "^5.0.0",
    "did-resolver": "^5.0.0",
    "multibase": "^4.0.6",
    "multiformats": "^9.6.2",
    "uint8arrays": "3.1.1"
  },
  "packageManager": "pnpm@12.4.2"
}
